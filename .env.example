# ==============================================================================
# KnowledgeGuard AI — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Provider choice: groq | gemini | openai
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# Alternative Providers (if LLM_PROVIDER is switched):
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_BASE_URL=

# ------------------------------------------------------------------------------
# 2. Relational Database (Application, Audit & History Persistence)
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL=sqlite:///data/knowledgeguard.db

# Production Deployment (Render PostgreSQL / Neon PostgreSQL):
# DATABASE_URL=postgresql://user:password@host.render.com/knowledgeguard_db

# ------------------------------------------------------------------------------
# 3. Vector Database (ChromaDB Document Embeddings & RAG Retrieval)
# ------------------------------------------------------------------------------
COLLECTION_NAME=knowledgeguard_documents
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Option A: Local Disk or Render Persistent Disk Volume (Recommended)
CHROMA_PERSIST_DIR=./data/chromadb

# Option B: External Chroma Server or Chroma Cloud (Optional)
# CHROMA_SERVER_HOST=
# CHROMA_SERVER_PORT=8000
# CHROMA_SERVER_SSL=false
# CHROMA_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 4. Backend Server & CORS Configuration
# ------------------------------------------------------------------------------
PYTHONPATH=.
HOST=0.0.0.0
PORT=8000
ENV=production
DEBUG=false


# Allowed frontend origin (Single or comma-separated):
FRONTEND_URL=https://knowledgeguardai-1.onrender.com
# Comma-separated allowed origins (Include local and production frontend URLs):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://knowledgeguardai-1.onrender.com,https://knowledgeguardai.onrender.com

# ------------------------------------------------------------------------------
# 5. Frontend Environment Variables (Set in Render Static Site Dashboard)
# ------------------------------------------------------------------------------
# In Render Static Site Settings > Environment Variables:
# VITE_API_URL=https://knowledgeguardai.onrender.com
# (VITE_API_BASE_URL is also supported as an alias)

